<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.bassemzohdy.openworkflow</groupId>
    <artifactId>open-workflow-agentic</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>oa-contracts</artifactId>
  <name>oa-contracts</name>
  <description>Pure Java contracts: ids, pagination, problem details, ports. Only the JDK at compile time.</description>

  <!-- No compile-scope dependency is allowed here: tools/check_dependency_policy.py fails the build otherwise. -->
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
    <!-- Schema tests only: a plain Jackson mapper writes samples and the networknt validator checks them. -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId></dependency>
  </dependencies>
</project>
