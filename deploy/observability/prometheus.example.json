{
  "global": {
    "scrape_interval": "15s",
    "evaluation_interval": "15s"
  },
  "rule_files": [
    "outbox-rules.json"
  ],
  "scrape_configs": [
    {
      "job_name": "open-workflow-agentic",
      "metrics_path": "/q/metrics",
      "static_configs": [
        {
          "targets": [
            "127.0.0.1:8080"
          ]
        }
      ],
      "metric_relabel_configs": [
        {
          "source_labels": [
            "__name__"
          ],
          "regex": "(agentic_outbox_unpublished|agentic_outbox_failed|agentic_outbox_unpublished_oldest_age_seconds|agentic_outbox_observation_healthy|agentic_outbox_observation_age_seconds)",
          "action": "keep"
        }
      ]
    }
  ]
}
