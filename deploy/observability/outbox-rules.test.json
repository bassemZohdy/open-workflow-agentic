{
  "rule_files": [
    "outbox-rules.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "healthy empty queue",
      "interval": "1m",
      "input_series": [
        {
          "series": "up{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "1x10"
        },
        {
          "series": "agentic_outbox_observation_healthy{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "1x10"
        },
        {
          "series": "agentic_outbox_observation_age_seconds{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "0x10"
        },
        {
          "series": "agentic_outbox_failed{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "0x10"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "5m",
          "alertname": "OutboxExporterUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxObservationMissing",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxObservationUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxObservationStale",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxPoisonRows",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "reachable database failure with retained poison rows",
      "interval": "1m",
      "input_series": [
        {
          "series": "up{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "1x10"
        },
        {
          "series": "agentic_outbox_observation_healthy{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "0x10"
        },
        {
          "series": "agentic_outbox_observation_age_seconds{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "10x10"
        },
        {
          "series": "agentic_outbox_failed{job=\"open-workflow-agentic\",instance=\"runtime:8080\"}",
          "values": "4x10"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "5m",
          "alertname": "OutboxExporterUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxObservationMissing",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxObservationUnavailable",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "open-workflow-agentic",
                "instance": "runtime:8080",
                "severity": "warning",
                "owner": "runtime-operations"
              },
              "exp_annotations": {
                "summary": "Outbox observation failed; retained lag is not current",
                "runbook_url": "https://github.com/bassemZohdy/open-workflow-agentic/blob/main/docs/operations-observability.md#observation-unavailable"
              }
            }
          ]
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxObservationStale",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "OutboxPoisonRows",
          "exp_alerts": []
        }
      ]
    },
