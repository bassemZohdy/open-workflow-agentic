{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "agentic-outbox-v1",
  "title": "Agentic outbox observations",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "agentic",
    "operations"
  ],
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "constant",
        "query": "open-workflow-agentic",
        "current": {
          "text": "open-workflow-agentic",
          "value": "open-workflow-agentic"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=~\"$job\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape target reachable",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds",
            "seriesBy": "last"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "description": "1 means the collector reached this target; 0 means the scrape failed. A missing series is unknown."
    },
    {
      "id": 2,
      "title": "Last completed observation succeeded",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds",
            "seriesBy": "last"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agentic_outbox_observation_healthy{job=~\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "description": "1 means the last completed database observation succeeded; 0 means failure or no successful observation yet. Check observation age for freshness."
    },
    {
      "id": 3,
      "title": "Age of last successful observation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agentic_outbox_observation_age_seconds{job=~\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Retained unpublished rows (per target)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agentic_outbox_unpublished{job=~\"$job\",instance=~\"$instance\"} and on(job,instance) (agentic_outbox_observation_healthy{job=~\"$job\",instance=~\"$instance\"} == 1) and on(job,instance) (up{job=~\"$job\",instance=~\"$instance\"} == 1) and on(job,instance) (agentic_outbox_observation_age_seconds{job=~\"$job\",instance=~\"$instance\"} <= 120)",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Age of oldest unpublished row",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agentic_outbox_unpublished_oldest_age_seconds{job=~\"$job\",instance=~\"$instance\"} and on(job,instance) (agentic_outbox_observation_healthy{job=~\"$job\",instance=~\"$instance\"} == 1) and on(job,instance) (up{job=~\"$job\",instance=~\"$instance\"} == 1) and on(job,instance) (agentic_outbox_observation_age_seconds{job=~\"$job\",instance=~\"$instance\"} <= 120)",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Retained poison rows (per target)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agentic_outbox_failed{job=~\"$job\",instance=~\"$instance\"} and on(job,instance) (agentic_outbox_observation_healthy{job=~\"$job\",instance=~\"$instance\"} == 1) and on(job,instance) (up{job=~\"$job\",instance=~\"$instance\"} == 1) and on(job,instance) (agentic_outbox_observation_age_seconds{job=~\"$job\",instance=~\"$instance\"} <= 120)",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    }
  ]
}
