<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.bassemzohdy.openworkflow</groupId>
    <artifactId>open-workflow-agentic</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>oa-testkit</artifactId>
  <name>oa-testkit</name>
  <description>Test support: acceptance annotation and status generator, scripted model, fault injection, fake IdP and policy service. No Quarkus application startup; never depends on oa-control.</description>

  <dependencies>
    <dependency><groupId>io.github.bassemzohdy.openworkflow</groupId><artifactId>oa-contracts</artifactId><version>${project.version}</version></dependency>
    <!-- The model double implements the LlmClient port that lives in oa-runtime (ADR 0012). -->
    <dependency><groupId>io.github.bassemzohdy.openworkflow</groupId><artifactId>oa-runtime</artifactId><version>${project.version}</version></dependency>

    <!-- Reads docs/requirements/*.json for the acceptance annotation and the status generator -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <!-- The @Acceptance extension is a JUnit 5 extension, so the API is on the compile classpath -->
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId></dependency>

    <!-- Tests -->
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-testkit</artifactId><scope>test</scope></dependency>
    <!-- Independent JWT verifier: the fake IdP is checked against a library that is not the issuer itself -->
    <dependency><groupId>com.nimbusds</groupId><artifactId>nimbus-jose-jwt</artifactId><scope>test</scope></dependency>
    <!-- Database outage through the fault proxy: JDBC to the local Postgres (CI service or docker compose) -->
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Writes target/classpath.txt so the status generator can run with plain java:
          java -cp "modules/oa-testkit/target/classes:$(cat modules/oa-testkit/target/classpath.txt)" <main class>
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>runtime-classpath-file</id>
            <phase>compile</phase>
            <goals><goal>build-classpath</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/classpath.txt</outputFile>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
