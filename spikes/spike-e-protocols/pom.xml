<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- WP-007 spike: characterization tests for MCP, A2A and agent-protocol capabilities.
       Standalone on purpose: not a module of the root build. Versions mirror the root pom. -->
  <groupId>io.github.bassemzohdy.openworkflow</groupId>
  <artifactId>spike-e-protocols</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>spike-e-protocols</name>
  <description>WP-007 Spike E: MCP, A2A and agent protocol characterization</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.version>3.39.5</quarkus.platform.version>
    <quarkus-langchain4j.version>1.14.2</quarkus-langchain4j.version>
    <surefire-plugin.version>3.5.3</surefire-plugin.version>
    <a2a.version>1.4.0.Final</a2a.version>
    <quarkus-mcp-server.version>2.0.3</quarkus-mcp-server.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkiverse.langchain4j</groupId>
        <artifactId>quarkus-langchain4j-bom</artifactId>
        <version>${quarkus-langchain4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Q1/Q3: Quarkus LangChain4j MCP client and OIDC MCP auth provider -->
    <dependency><groupId>io.quarkiverse.langchain4j</groupId><artifactId>quarkus-langchain4j-mcp</artifactId></dependency>
    <dependency><groupId>io.quarkiverse.langchain4j</groupId><artifactId>quarkus-langchain4j-oidc-mcp-auth-provider</artifactId></dependency>

    <!-- Tests -->
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-junit5</artifactId><scope>test</scope></dependency>
    <!-- Q2: in-process MCP server (Quarkiverse, streamable HTTP) for characterization tests -->
    <dependency><groupId>io.quarkiverse.mcp</groupId><artifactId>quarkus-mcp-server-http</artifactId><version>${quarkus-mcp-server.version}</version><scope>test</scope></dependency>
  </dependencies>

  <profiles>
    <!-- A2A characterization (Q04 to Q07). Opt-in with -Pa2a so the default MCP run does not carry the
         A2A SDK and its gRPC/protobuf stack. One default-classpath run with the A2A reference server
         stalled in Quarkus bean discovery for more than 10 minutes; the profile run later augmented in
         about 20 seconds, so the cause is not established (see docs/spikes/WP-007). -->
    <profile>
      <id>a2a</id>
      <dependencies>
        <!-- Q4/Q5: A2A Java SDK (org.a2aproject.sdk, spec 1.0+ line) -->
        <dependency><groupId>org.a2aproject.sdk</groupId><artifactId>a2a-java-sdk-client</artifactId><version>${a2a.version}</version></dependency>
        <!-- Q5: in-process A2A JSON-RPC reference server -->
        <dependency><groupId>org.a2aproject.sdk</groupId><artifactId>a2a-java-sdk-reference-jsonrpc</artifactId><version>${a2a.version}</version><scope>test</scope></dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <testExcludes combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- A2A sources only compile with the a2a profile (they need the A2A SDK on the classpath). -->
          <testExcludes>
            <testExclude>**/protocols/a2a/**</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
